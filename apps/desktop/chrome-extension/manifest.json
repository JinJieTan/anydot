{
  "manifest_version": 3,
  "name": "aitech 浏览器助手",
  "description": "让 aitech 桌面端的 Agent 在你的 Chrome 里打开网页、点击、输入和截图。只连接本机的 aitech。",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["debugger", "tabs", "tabGroups", "scripting", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "aitech 浏览器助手", "default_popup": "popup.html" }
}
