{
  "name": "@aitech/desktop",
  "productName": "AnyDot",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "AnyDot desktop client",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "pack:dir": "electron-vite build && electron-builder --dir",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:mac:unsigned": "electron-vite build && electron-builder --mac -c.mac.identity=- -c.mac.hardenedRuntime=false",
    "dist:win": "electron-vite build && electron-builder --win",
    "test": "vitest run"
  },
  "devDependencies": {
    "@aitech/agent": "workspace:*",
    "@aitech/core": "workspace:*",
    "@aitech/db": "workspace:*",
    "@aitech/protocol": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "clsx": "2.1.1",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "fflate": "0.8.3",
    "highlight.js": "11.12.0",
    "lucide-react": "1.52.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.3",
    "vite": "7.3.7",
    "ws": "8.22.0",
    "zustand": "5.0.15"
  }
}
